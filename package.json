{
  "name": "query-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:mockModel": "tsx server.ts --mockModel",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "test:sql": "node --import tsx --test tests/sqlValidation.test.ts",
    "test:mockModel": "node --import tsx --test tests/mockModel.test.ts",
    "test:stream": "node --import tsx --test tests/queryStreaming.test.ts",
    "test:manual": "node --import tsx --test tests/manualQuery.test.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:banking:up": "docker compose up -d --wait banking-postgres",
    "db:seed:docker": "npm run db:seed:banking",
    "db:seed:banking": "docker compose exec -T banking-postgres psql -U banking_app -d banking_demo -v ON_ERROR_STOP=1 --single-transaction -f /docker-entrypoint-initdb.d/01-populate-test-db.sql",
    "test:db": "node --import tsx --test tests/database.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/openai": "^1.6.2",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/functions": "^3.9.11",
    "codemirror": "^6.0.2",
    "dt-sql-parser": "^4.5.1",
    "langchain": "^1.5.15",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sequelize": "^6.37.8",
    "sql-formatter": "^15.9.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5"
  }
}
