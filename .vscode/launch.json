{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "name": "Debug: Node server",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/server.ts",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "name": "Debug: Node server (mock model)",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "program": "${workspaceFolder}/server.ts",
      "args": [
        "--mockModel"
      ],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "name": "Debug: Current test file",
      "runtimeArgs": [
        "--import",
        "tsx",
        "--test"
      ],
      "args": [
        "${file}"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "name": "Debug: All tests",
      "runtimeArgs": [
        "--import",
        "tsx",
        "--test"
      ],
      "args": [
        "${workspaceFolder}/tests/database.test.ts",
        "${workspaceFolder}/tests/databaseSchema.test.ts",
        "${workspaceFolder}/tests/manualQuery.test.ts",
        "${workspaceFolder}/tests/mockModel.test.ts",
        "${workspaceFolder}/tests/queryStreaming.test.ts",
        "${workspaceFolder}/tests/sqlValidation.test.ts"
      ]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach: Node process",
      "processId": "${command:PickProcess}",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    }
  ]
}
