# Query agent provider: gemini (default) or openai. Keys stay on the server.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=your_api_key_here

# Optional provider-specific key/model overrides
GEMINI_API_KEY=
OPENAI_API_KEY=
LANGCHAIN_MODEL=

# Custom Node server port (default: 3000)
PORT=3000

# Server-only PostgreSQL connection (local compose.yaml credentials)
DATABASE_URL=postgresql://query_app:query_app_local@localhost:5432/query_app
# Optional separate connection with schema/create/insert privileges for seeding
DATABASE_SEED_URL=
