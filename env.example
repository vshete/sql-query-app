# Query agent provider: gemini (default) or openai. Keys stay on the server.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=your_api_key_here

# Optional provider-specific key/model overrides
GEMINI_API_KEY=
OPENAI_API_KEY=
LANGCHAIN_MODEL=

# Custom Node server port (default: 3000)
PORT=3000

# Server-only default database. Paste your Neon PostgreSQL connection URL here.
# Use sslmode=verify-full to verify the server certificate and hostname.
# Preserve other SSL parameters from your provider. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=verify-full
# Optional separate connection with schema/create/insert privileges for seeding
DATABASE_SEED_URL=
